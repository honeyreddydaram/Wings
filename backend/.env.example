APP_MODE=demo
DATABASE_PATH=/tmp/cowingman.db
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
PUBLIC_BASE_URL=http://localhost:8000

# Authentication. Demo preserves the credential-free local workflow. Set
# firebase only when the client is configured and the server has ADC/service-account access.
AUTH_MODE=demo
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CHECK_REVOKED=false

# Inference boundary. Live Gemma uses Vertex AI dedicated endpoints or Model Garden with ADC.
INFERENCE_PROVIDER=demo
INFERENCE_MODEL=gemini-2.5-flash
GEMMA_MODEL=google/gemma-4-12b
GEMMA_LOCATION=us-central1
# GEMMA_ENDPOINT_ID=  # Numeric Vertex AI Endpoint ID for dedicated deployment.
# GEMMA_ENDPOINT_DNS= # Dedicated endpoint domain (e.g., <endpoint_id>.<region>-<project_number>.prediction.vertexai.goog).
# GEMMA_BASE_URL=     # Optional direct OpenAI-compatible URL override (e.g., https://<dns>/v1).
INFERENCE_TIMEOUT_SECONDS=20
INFERENCE_MAX_RETRIES=2
TTS_MODEL=gemini-2.5-flash-preview-tts

# M3 rolling-audio defaults. The Expo client should use the same chunk duration.
AUDIO_WINDOW_SECONDS=4
SUMMARY_CHECKPOINT_SECONDS=120
MAX_AUDIO_BYTES=8388608

# Privacy-safe OpenTelemetry. When enabled, traces and metrics are sent to the
# configured OTLP/HTTP collector; never configure header/body capture there.
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_ENABLED=false
OTEL_SERVICE_NAME=cowingman-api
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.com
OTEL_SAMPLE_RATIO=0.1

# Application safeguards. The edge limiter is per process; a deployed service
# must also use a distributed edge control such as Cloud Armor/API Gateway.
EDGE_RATE_LIMIT_PER_MINUTE=180
PROVIDER_BUDGET_PER_MINUTE=60

# Enforced storage/access defaults. Profile, card, and contact records remain
# until user deletion; the authenticated privacy endpoint reports this policy.
SESSION_ACCESS_TTL_HOURS=2
SESSION_STORAGE_TTL_DAYS=1
SUMMARY_OBJECT_TTL_DAYS=30

# Live mode additionally requires these server-side variables:
# APP_MODE=live
# AUTH_MODE=firebase
# INFERENCE_PROVIDER=gemma
# GEMMA_MODEL=google/gemma-4-12b
# GEMMA_LOCATION=us-central1
# GEMMA_ENDPOINT_ID=your-numeric-endpoint-id
# GEMMA_ENDPOINT_DNS=your-dedicated-endpoint-dns
# GOOGLE_CLOUD_PROJECT=your-project-id
# SPEECH_LOCATION=us
# SPEECH_LANGUAGE=en-US
# FIRESTORE_COLLECTION=cowingman
# SUMMARY_BUCKET=
