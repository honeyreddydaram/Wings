APP_MODE=demo
DATABASE_PATH=/tmp/cowingman.db
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Authentication. Demo preserves the credential-free local workflow. Set
# firebase only when the client is configured and the server has ADC/service-account access.
AUTH_MODE=demo
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CHECK_REVOKED=false

# Inference boundary. Gemma is reserved for Milestone 5 and is not implemented yet.
INFERENCE_PROVIDER=demo
INFERENCE_MODEL=gemini-2.5-flash
TTS_MODEL=gemini-2.5-flash-preview-tts

# Future pipeline defaults; only MAX_AUDIO_BYTES is enforced in Milestone 1.
AUDIO_WINDOW_SECONDS=4
SUMMARY_CHECKPOINT_SECONDS=120
MAX_AUDIO_BYTES=8388608

# OTEL_ENABLED documents the future switch; M1 does not export OpenTelemetry data.
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_ENABLED=false
OTEL_SERVICE_NAME=cowingman-api

# Live mode additionally requires these server-side variables:
# APP_MODE=live
# AUTH_MODE=firebase
# INFERENCE_PROVIDER=gemini
# GEMINI_API_KEY=
# GOOGLE_CLOUD_PROJECT=your-project-id
# SPEECH_LOCATION=us
# SPEECH_LANGUAGE=en-US
# FIRESTORE_COLLECTION=cowingman
# SUMMARY_BUCKET=
