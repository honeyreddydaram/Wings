EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_AUDIO_CHUNK_SECONDS=4

# Firebase web-app configuration. These identifiers are embedded in the client
# by design; they are not service-account credentials. Keep backend secrets out
# of EXPO_PUBLIC_* variables and restrict the API key in Google Cloud.
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
